# Copy to .env.release and fill in real values to run `Scripts/build-release.sh --distribute`
# locally. The `.env.release` file is gitignored — never commit real secrets.
#
# These same values are what you store as the GitHub Actions repository secrets
# for the GitHub Release workflow (see .github/workflows/release.yml).

# Developer ID Application certificate (base64 of the exported .p12).
#   base64 < ~/Downloads/DeveloperID.p12
DEVELOPER_ID_CERT=""

# The password you used when exporting the .p12.
DEVELOPER_ID_CERT_PASSWORD=""

# The full signing identity from `security find-identity -v -p codesigning`,
# e.g. "Developer ID Application: Jason Rimmer (SPKZTCVC54)".
DEVELOPER_ID_APPLICATION=""

# App Store Connect API key (base64 of the .p8 file).
#   base64 < ~/Downloads/AuthKey_B8JKF883DC.p8
ASC_API_KEY=""

# The API key ID (from the filename, e.g. B8JKF883DC).
ASC_API_KEY_ID=""

# The App Store Connect issuer ID (UUID from Users and Access -> Integrations).
ASC_ISSUER_ID=""
